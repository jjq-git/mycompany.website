# 复制为 .env 并填好真实值（.env 已在 .gitignore 中）

# Flask —— SECRET_KEY 现在是 fail-closed：默认按生产对待，未设就拒绝启动（防裸 gunicorn
# 静默用硬编码 key）。本地开发要么在此设 SECRET_KEY，要么设 FLASK_DEBUG=1 显式声明开发环境。
# 生成方法: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-random-string

# 开发设 FLASK_DEBUG=1 打开调试器(并允许 SECRET_KEY 回落临时值); 生产必须保持空或 0。
# 注意: host 非本机(0.0.0.0)时 debug=1 会被拒绝启动(Werkzeug 调试器=RCE 风险)。
# FLASK_DEBUG=0
# FLASK_HOST=127.0.0.1
# FLASK_PORT=5000
# FLASK_ENV=production    # 生产部署时设置, 强制 SECRET_KEY 不能为空

# 数据库（默认 SQLite，规模化后改 PostgreSQL）
# DATABASE_URL=postgresql://user:pass@localhost/mycompany

# 平台域名
PLATFORM_DOMAIN=mycompany.website

# data-* 声明式 block 总开关（默认 1=开）。设 0 回退到旧 Jinja2 渲染(需本地有 .jinja2.bak)。
# ENABLE_DATA_ATTR_BLOCKS=1

# 上传 multipart 总大小上限(字节)，默认 25165824 = 24MB。防巨型文件/图片炸弹耗尽磁盘内存。
# MAX_CONTENT_LENGTH=25165824

# AI 翻译（DeepSeek API，OpenAI 兼容格式。不填则不显示翻译按钮）
# TRANSLATION_API_KEY=sk-your-deepseek-key
# TRANSLATION_API_BASE=https://api.deepseek.com/v1
# TRANSLATION_MODEL=deepseek-chat
