# 复制为 .env 并填好真实值（.env 已在 .gitignore 中）

# Flask —— SECRET_KEY 现在是 fail-closed：默认按生产对待，未设就拒绝启动（防裸 gunicorn
# 静默用硬编码 key）。本地开发要么在此设 SECRET_KEY，要么设 FLASK_DEBUG=1 显式声明开发环境。
# 生成方法: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-random-string

# 开发设 FLASK_DEBUG=1 打开调试器(并允许 SECRET_KEY 回落临时值); 生产必须保持空或 0。
# 注意: host 非本机(0.0.0.0)时 debug=1 会被拒绝启动(Werkzeug 调试器=RCE 风险)。
# FLASK_DEBUG=0
# FLASK_HOST=127.0.0.1
# FLASK_PORT=5000
# FLASK_ENV=production    # 生产部署时设置, 强制 SECRET_KEY 不能为空

# 邮箱验证码（标准 SMTP）
# 两种加密二选一：
#   ① 587 + STARTTLS（Gmail、Outlook 等）：SMTP_PORT=587  SMTP_USE_TLS=1  SMTP_USE_SSL=0
#   ② 465 + SSL 直连（阿里云邮件推送、多数企业邮）：SMTP_PORT=465  SMTP_USE_SSL=1
# SMTP_USE_SSL=1 时忽略 SMTP_USE_TLS，直接建立 SSL 连接，不再走 STARTTLS。
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=1
SMTP_USE_SSL=0

# 手机验证码通道二选一：优先 webhook，未配置 webhook 时回退阿里云直连。
# ① 自定义 webhook：POST JSON {phone, code, purpose}，Authorization: Bearer <token>
SMS_WEBHOOK_URL=
SMS_WEBHOOK_TOKEN=
# ② 阿里云短信（Dysmsapi）直连：填下面四项即可，无需 webhook。AccessKey 属机密，勿提交 git。
# 模板变量沿用 {code}，签名/模板见阿里云短信控制台。
ALIYUN_SMS_ACCESS_KEY_ID=
ALIYUN_SMS_ACCESS_KEY_SECRET=
ALIYUN_SMS_SIGN_NAME=昆山德恩基电子科技
ALIYUN_SMS_TEMPLATE_CODE=SMS_337130283

# 仅本地开发使用：随机生成验证码并直接显示在验证页；生产环境必须删除或设为 send。
# VERIFICATION_CODE_MODE=display

# 数据库（默认 SQLite，规模化后改 PostgreSQL）
# DATABASE_URL=postgresql://user:pass@localhost/mycompany

# 平台域名（生产部署必须设置真实域名；本地开发留空则表单提交到 localhost:5000）
# PLATFORM_DOMAIN=mycompany.website

# data-* 声明式 block 总开关（默认 1=开）。设 0 回退到旧 Jinja2 渲染(需本地有 .jinja2.bak)。
# ENABLE_DATA_ATTR_BLOCKS=1

# 预览页登录控制。默认 1=需登录+归属校验（secure-by-default，保护未发布私密站点，
# 防匿名枚举 site id 越权读取）。仅本地测试想免登录分享预览链接时，显式设 0 关闭。
# PREVIEW_REQUIRE_LOGIN=0

# 上传 multipart 总大小上限(字节)，默认 25165824 = 24MB。防巨型文件/图片炸弹耗尽磁盘内存。
# MAX_CONTENT_LENGTH=25165824

# AI 翻译 / SEO 简介生成（DeepSeek API，OpenAI 兼容格式。不填则使用本地摘要兜底）
# TRANSLATION_API_KEY=sk-your-deepseek-key
# TRANSLATION_API_BASE=https://api.deepseek.com/v1
# TRANSLATION_MODEL=deepseek-chat
