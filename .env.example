# 复制为 .env 并填好真实值（.env 已在 .gitignore 中）

# Flask
SECRET_KEY=change-me-to-a-random-string

# 数据库（默认 SQLite，规模化后改 PostgreSQL）
# DATABASE_URL=postgresql://user:pass@localhost/mycompany

# 平台域名
PLATFORM_DOMAIN=mycompany.website

# 阿里云（M5 发布阶段才需要）
# ALIYUN_ACCESS_KEY_ID=
# ALIYUN_ACCESS_KEY_SECRET=
# ALIYUN_OSS_BUCKET=
# ALIYUN_OSS_REGION=cn-hangzhou
