# 复制为 .env 并填好真实值（.env 已在 .gitignore 中）

# Flask
SECRET_KEY=change-me-to-a-random-string

# 数据库（默认 SQLite，规模化后改 PostgreSQL）
# DATABASE_URL=postgresql://user:pass@localhost/mycompany

# 平台域名
PLATFORM_DOMAIN=mycompany.website

# AI 翻译（DeepSeek API，OpenAI 兼容格式。不填则不显示翻译按钮）
# TRANSLATION_API_KEY=sk-your-deepseek-key
# TRANSLATION_API_BASE=https://api.deepseek.com/v1
# TRANSLATION_MODEL=deepseek-chat
