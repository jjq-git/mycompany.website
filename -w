<script>
// --- Header scroll shadow ---
(function() {
  var header = document.getElementById('siteHeader');
  if (!header) return;
  window.addEventListener('scroll', function() {
    header.classList.toggle('scrolled', window.scrollY > 50);
  });
})();

// --- Mobile menu toggle ---
function toggleMobileMenu() {
  var nav = document.getElementById('headerNav');
  var toggle = document.getElementById('menuToggle');
  if (!nav || !toggle) return;
  nav.classList.toggle('mobile-open');
  toggle.classList.toggle('active');
}

// --- Navigation dropdowns ---
function toggleMenuDropdown(e, button) {
  e.stopPropagation();
  var dropdown = button.closest('.nav-dropdown');
  if (!dropdown) return;
  var isOpen = dropdown.classList.contains('open');
  if (!dropdown.classList.contains('nav-dropdown-nested')) {
    document.querySelectorAll('.header-nav > .nav-dropdown.open').forEach(function(openDropdown) {
      if (openDropdown !== dropdown) openDropdown.classList.remove('open');
    });
  }
  dropdown.classList.toggle('open', !isOpen);
  button.setAttribute('aria-expanded', String(!isOpen));
}

// --- Language dropdown ---
function toggleLangDropdown(e) {
  e.stopPropagation();
  var menu = document.getElementById('langDropdownMenu');
  if (!menu) return;
  var isOpen = menu.style.display === 'block';
  menu.style.display = isOpen ? 'none' : 'block';
}

// --- Nav active state ---
(function() {
  var path = window.location.pathname;

  // 剥离预览前缀、语言前缀和尾部斜杠
  var cleaned = path
    .replace(/\/templates\/[^/]+\/preview/, '')
    .replace(/\/preview\/\d+/, '')
    .replace(/^\/(zh-CN|zh-TW|en)/, '')
    .replace(/\/$/, '') || '/';

  // 首页: cleaned 是 / 或空
  if (cleaned === '/' || cleaned === '') {
    document.querySelectorAll('.header-nav .nav-link').forEach(function(l) { l.classList.remove('active'); });
    var homeLink = document.querySelector('.header-nav .nav-link:first-child');
    if (homeLink) homeLink.classList.add('active');
    return;
  }

  // 先清除所有
  document.querySelectorAll('.header-nav .nav-link').forEach(function(l) { l.classList.remove('active'); });

  document.querySelectorAll('.header-nav a.nav-link, .header-nav a.nav-dropdown-item').forEach(function(link) {
    var href = link.getAttribute('href') || '';
    if (href.indexOf('http') === 0 || href === '#') return;
    var normalized = href
      .replace(/\/templates\/[^/]+\/preview/, '')
      .replace(/\/preview\/\d+/, '')
      .replace(/^\/(zh-CN|zh-TW|en)/, '')
      .replace(/\/$/, '') || '/';
    if (normalized === cleaned || (normalized !== '/' && cleaned.indexOf(normalized + '/') === 0)) {
      link.classList.add('active');
      var dropdown = link.closest('.nav-dropdown');
      if (dropdown) {
        var parentLink = dropdown.querySelector(':scope > .nav-dropdown-parent > .nav-dropdown-link');
        if (parentLink) parentLink.classList.add('active');
        var arrow = dropdown.querySelector(':scope > .nav-dropdown-parent > .nav-dropdown-arrow');
        if (arrow) arrow.classList.add('active');
      }
    }
  });
})();

// Close dropdowns on outside click
document.addEventListener('click', function(e) {
  var langMenu = document.getElementById('langDropdownMenu');
  var langSwitcher = document.getElementById('langSwitcher');
  if (langMenu && !langSwitcher.contains(e.target)) {
    langMenu.style.display = 'none';
  }
  document.querySelectorAll('.header-nav .nav-dropdown.open').forEach(function(dropdown) {
    if (!dropdown.contains(e.target)) dropdown.classList.remove('open');
  });
});
</script>

